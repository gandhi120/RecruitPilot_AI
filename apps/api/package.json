    "@prisma/client": "^6.19.3",
    "@recruitpilot/shared": "*",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^5.0.0",
    "pino": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  }
}
