# ===========================================================================
# RecruitPilot AI — environment template
# ---------------------------------------------------------------------------
# This file is COMMITTED and contains NO real values — only names + comments.
# Copy it to `.env` (which is git-ignored) and fill in real values as you reach
# each setup doc. The Zod schema in apps/api/src/core/config/env.ts validates
# these at boot and FAILS FAST if a required one is missing (doc 09).
#
# Vars are grouped by the doc that introduces them. Only the CORE group is
# needed for Phase 0 (Milestones 1–4); the rest come online as their features
# are built, so they stay optional until then.
# ===========================================================================

# --- CORE / runtime (doc 09) — needed from Milestone 2 ---------------------
NODE_ENV=development            # development | production | test
PORT=3000                      # Fastify API port
HOST=0.0.0.0                   # 0.0.0.0 so it's reachable inside Docker (doc 13)
LOG_LEVEL=info                 # pino level: trace|debug|info|warn|error|fatal

# --- Redis (doc 13) — needed from Milestone 3 ------------------------------
REDIS_URL=redis://localhost:6379   # inside compose this becomes redis://redis:6379

# --- Supabase: database, auth, storage (doc 04, 11) ------------------------
SUPABASE_URL=                  # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=             # public/anon key (RLS-bound) — safe server-side use
SUPABASE_SERVICE_ROLE_KEY=     # SECRET — bypasses RLS. api/worker env ONLY, never web
SUPABASE_JWT_SECRET=           # verifies dashboard JWTs (doc 12); prefer JWKS if shown
DATABASE_URL=                  # pooled (port 6543) — app runtime, Prisma queries
DIRECT_URL=                    # direct (port 5432) — Prisma migrate only

# --- Exotel: telephony (doc 05) --------------------------------------------
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=              # e.g. api.in.exotel.com (Indian cluster)
EXOTEL_VIRTUAL_NUMBER=        # your ExoPhone in E.164
VOICE_WS_AUTH_TOKEN=          # WE generate: openssl rand -hex 32 — gates /voice/stream

# --- Deepgram: speech-to-text (doc 06) -------------------------------------
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2-phonecall
DEEPGRAM_ENDPOINTING_MS=300

# --- Anthropic: Claude LLM (doc 07) ----------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_REALTIME=claude-haiku-4-5-20251001   # verify current id at docs.anthropic.com
ANTHROPIC_MODEL_SUMMARY=claude-sonnet-4-6            # verify current id

# --- ElevenLabs: text-to-speech (doc 08) -----------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=ulaw_8000

# --- Google Calendar + resume (doc 16) -------------------------------------
GOOGLE_CALENDAR_ID=                 # usually Varun's email
GOOGLE_SERVICE_ACCOUNT_JSON=        # base64 of the service-account JSON key. SECRET
RESUME_STORAGE_PATH=documents/resume.pdf

# --- Voice pipeline tuning (doc 17) ----------------------------------------
VOICE_JITTER_BUFFER_MS=40
BARGE_IN_ENERGY_THRESHOLD=800
VOICE_MAX_CALL_SECONDS=600

# --- Web dashboard (doc 10) — NEXT_PUBLIC_* are bundled into browser JS -----
# These are NOT secret by definition; never put a secret behind NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Test-only (doc 19) — CI uses fakes, never real vendor keys ------------
TEST_DATABASE_URL=
TEST_REDIS_URL=redis://localhost:6379
USE_FAKE_PROVIDERS=true
