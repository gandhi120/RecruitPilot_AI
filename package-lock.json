{
  "name": "recruitpilot",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "recruitpilot",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/api": {
      "name": "@recruitpilot/api",
      "version": "0.0.0",
      "dependencies": {
        "@recruitpilot/shared": "*"
      }
    },
    "node_modules/@recruitpilot/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@recruitpilot/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/shared": {
      "name": "@recruitpilot/shared",
      "version": "0.0.0"
    }
  }
}
